root = true
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Pi App Studio domain validation: served byte-exact, never add a trailing newline
[public/pi-app-validation.txt]
insert_final_newline = false
trim_trailing_whitespace = false
