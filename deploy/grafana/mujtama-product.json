{
 "__inputs": [
  {
   "name": "DS_PROMETHEUS",
   "label": "Prometheus",
   "type": "datasource",
   "pluginId": "prometheus",
   "pluginName": "Prometheus"
  }
 ],
 "uid": "mujtama-product",
 "title": "مجتمع بلس — مؤشرات المنتج",
 "tags": [
  "mujtama",
  "product"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "1m",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "instance",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "${DS_PROMETHEUS}"
    },
    "query": "label_values(mujtama_app_info, instance)",
    "includeAll": true,
    "multi": true,
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "refresh": 2
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Registered users",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max(mujtama_users_total{instance=~\"$instance\"})",
     "legendFormat": "users",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     }
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Published posts",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max(mujtama_posts_total{instance=~\"$instance\"})",
     "legendFormat": "posts",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     }
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "New users / day",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max(increase(mujtama_users_total{instance=~\"$instance\"}[1d]))",
     "legendFormat": "signups",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     }
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "New posts / day",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max(increase(mujtama_posts_total{instance=~\"$instance\"}[1d]))",
     "legendFormat": "posts",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     }
    }
   ]
  }
 ],
 "description": "Phase 49. Import in Grafana (Dashboards → Import) and pick your Prometheus data source. Retention cohorts/DAU live in the admin panel #/admin/ops/product (computed from the database)."
}