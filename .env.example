# مجتمع بلس — server configuration
PORT=8080
NODE_ENV=production          # enables Secure cookies (serve behind HTTPS)
# DATABASE_URL=postgres://user:pass@host:5432/mujtama   (omit → local SQLite file via SQLITE_FILE)
SQLITE_FILE=./data.sqlite
STORAGE_DIR=./storage         # media object storage (swap for S3/R2 adapter + CDN in production)
# STORAGE_DRIVER=db           # keep uploads + chat attachments in the database (survives redeploys on an ephemeral disk)
# STORAGE_DB_MAX_FILE_MB=25   # db driver: per-file cap (HTTP 413 above it)
# STORAGE_DB_MAX_TOTAL_MB=300 # db driver: total cap so the database volume cannot fill (HTTP 413 above it)
# STORAGE_DB_WARN_PCT=80      # db driver: log a warning above this share of the total cap
SEED_DEMO=1                   # seed demo users/posts on an empty database (0 in production)
TRUST_PROXY=0                 # 1 when behind a reverse proxy/load balancer
# --- Pi Network (phase 36, docs/PI.md) — off by default, testnet by default; no real money unless both mainnet flags are set ---
PI_ENABLED=0
PI_API_KEY=                   # Server API Key from the Pi Developer Portal (secret; PI_API_KEY_FILE also works). Never logged.
PI_API_URL=https://api.minepi.com
PI_NETWORK=testnet            # testnet | mainnet — mainnet is ignored unless PI_MAINNET_CONFIRM=1 too
PI_MAINNET_CONFIRM=0          # 1 = I really mean mainnet (real Pi). Leave 0.
# PI_SANDBOX=1                # testnet only: tell the client to Pi.init({sandbox:true}); 0 inside the Pi Browser testnet app
# PI_APP_ID=                  # optional, returned by GET /api/pi/config
# PI_MAX_AMOUNT=1000          # max Pi per payment intent
# PI_PURPOSES=tip,donation,subscription,boost,purchase,event_ticket,ppv,test
# PI_INTENT_TTL_HOURS=24      # unpaid intents are cancelled by the reconciliation after this
# PI_JOBS=1                   # 0 disables the hourly leased job that runs the daily reconciliation
# PI_RECONCILE_INTERVAL_MS=3600000
# PI_EXPLORER_URL=https://blockexplorer.minepi.com
# --- Tips & creator support (phase 37, docs/TIPS.md) — all optional; payments go through the Pi service ---
# CREATOR_FEE_BPS=0             platform fee on tips/support in basis points (500 = 5 %)
# TIPS_MAX_SINGLE=100  TIPS_MAX_DAILY=500  TIPS_MAX_PER_HOUR=20  TIPS_NEW_ACCOUNT_DAYS=3  TIPS_NEW_ACCOUNT_DAILY=10
# TIPS_VELOCITY_COUNT=5  TIPS_VELOCITY_WINDOW_MIN=10  TIPS_HOLD_AMOUNT=0 (0 = off)
# SUPPORT_MAX_AMOUNT=100  SUPPORT_PERIOD_DAYS=30  SUPPORT_REMIND_DAYS=3  SUPPORT_GRACE_DAYS=3
# TIPS_JOBS=1  TIPS_JOB_INTERVAL_MS=3600000
# --- Subscriptions & paid content (phase 38, docs/PAID.md) — all optional; CREATOR_FEE_BPS applies to PPV too ---
# PAID_MAX_PRICE=100            max PPV price in Pi (min 0.01)
# PAID_REFUND_WINDOW_HOURS=24   buyer may ask for a refund this long after the creator edits/deletes the post or moderation removes it
# PAID_TEASER_CHARS=200         automatic teaser length (never more than 40 % of the body)
# --- Community marketplace (phase 39, docs/MARKET.md) — all optional; needs `market` in PI_PURPOSES if that is set explicitly ---
# MARKET_MAX_PRICE=1000         max listing price (and max order total) in Pi (min 0.01, 7 decimals)
# MARKET_FEE_PCT=0              platform fee in percent, taken from the seller's share on release
# MARKET_AUTO_RELEASE_DAYS=7    escrow is released to the seller this long after the order is marked delivered (unless disputed)
# --- Phase 40: ethical ads (all optional) ---
# ADS_ENABLED=1                 0 = no promoted posts in feeds (campaign manager still works)
# ADS_FEED_INTERVAL=8           at most one promoted post per this many organic feed posts (never the first slot)
# ADS_K_ANON=10                 advertiser-facing counts below this are shown as «أقل من 10»
# ADS_MIN_BUDGET=1 / ADS_MAX_BUDGET=1000   campaign budget range in Pi (also bounded by PI_MAX_AMOUNT when funding)
# ADS_MIN_CPM=0.01 / ADS_MAX_CPM=100 / ADS_DEFAULT_CPM=0.5   CPM bid range in Pi per 1000 impressions
# ADS_MAX_DAYS=90               longest campaign
# ADS_BUDGET_LOW_PCT=80         ad_budget_low notification threshold
# ADS_FREQ_RETENTION_DAYS=7     ad_freq / ad_tokens rows are purged after this (job ads.maintain)
# ADS_JOB_INTERVAL_MS=600000    ads.maintain cadence (purge, complete ended campaigns, journal spend); ADS_JOBS=0 disables
# ADS_TOKEN_SECRET=             optional signing key for feed ad tokens (otherwise generated and stored in ad_meta)
# --- Phase 41: AI subscriptions + real translation + interface languages (docs/AI-TRANSLATION.md) — all optional ---
# Interface languages ar/en/fr/ur and the UI string manager are free and need nothing here.
# AI_PLAN_PRICE=                monthly price in Pi for «مجتمع+ ذكاء» (unset = no price; an admin price set in #/admin/ai wins)
# AI_PERIOD_DAYS=30             subscription period; AI_REMIND_DAYS=3 renewal reminder before the end
# AI_TRANSLATE_MONTHLY_CHARS=200000 / AI_TRANSLATE_MONTHLY_USD=0.5   per-user monthly caps (plan limits override)
# AI_PROVIDER_MONTHLY_USD=5     global monthly provider budget; reached → 503 budget_exhausted (cache hits still served)
# AI_PI_USD_RATE=               optional Pi→USD rate, only to show the margin in finance
# AI_TRANSLATE_PROVIDER=        openai | deepl | libre | none (unset = first configured of deepl, openai, libre)
# DEEPL_API_KEY=                (":fx" keys use the free endpoint; no Urdu) DEEPL_USD_PER_MCHAR=25
# OPENAI_API_KEY= OPENAI_BASE_URL= TRANSLATE_MODEL=gpt-4o-mini   any OpenAI-compatible endpoint
# TRANSLATE_URL= TRANSLATE_KEY= LibreTranslate-compatible; TRANSLATE_PRIVATE=1 only for a self-hosted instance
#                               (a keyless public instance never receives private messages)
# AI_TRANSLATE_MAX_CHARS=5000   longest text per translation; AI_MESSAGE_CACHE_DAYS=30 chat translation cache lifetime
# needs `ai` in PI_PURPOSES if that is set explicitly
