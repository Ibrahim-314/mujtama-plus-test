{
  "name": "mujtama-plus",
  "version": "2.143.0",
  "private": true,
  "description": "مجتمع بلس — منصة اجتماعية عربية على Pi Network",
  "scripts": {
    "start": "node server/server.js",
    "build": "node tools/build.mjs",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{js,mjs,css,md,json,yml}\"",
    "format:check": "prettier --check \"tools/**/*.mjs\" \"tests/**/*.js\" \"server/lib/**/*.js\"",
    "typecheck": "tsc -p tsconfig.json",
    "test": "npm run test:api && npm run test:unit",
    "test:api": "node --test --test-concurrency=1 \"server/test/*.test.js\"",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/*.test.js\"",
    "test:load": "node tools/load.mjs",
    "budget": "node tools/budget.mjs && node tools/design-lint.mjs",
    "a11y:audit": "node tools/a11y-audit.mjs",
    "seed": "node server/scripts/seed-demo.js",
    "icons": "python3 tools/icons.py",
    "cap:sync": "node tools/capacitor.mjs sync",
    "cap:android": "node tools/capacitor.mjs android",
    "cap:ios": "node tools/capacitor.mjs ios",
    "lint:design": "node tools/design-lint.mjs"
  },
  "devDependencies": {
    "@babylonjs/core": "^9.32.0",
    "@babylonjs/loaders": "^9.32.0",
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "autocannon": "^7.15.0",
    "axe-core": "^4.14.0",
    "esbuild": "^0.24.2",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "pixelmatch": "^5.3.0",
    "playwright-core": "1.48",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "qrcode-generator": "^1.5.2",
    "three": "^0.169.0",
    "typescript": "^5.9.3"
  }
}
